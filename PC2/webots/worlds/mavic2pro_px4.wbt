# ===== END ZONE B =====
Mavic2Pro {
  translation 0 0 0.5
  rotation -0.0018273642989068096 0.0006333165374266473 0.9999981298231926 -3.1142226276225933
  controller "px4_bridge"
  supervisor TRUE
  cameraSlot [
    Camera {
      width 640
      height 480
      near 0.2
    }
  ]
}
