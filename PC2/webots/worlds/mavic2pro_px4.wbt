DEF _ WorldInfo {
  info [
    "Drone Autonomous Detection - Webots Simulation"
    "MAVLink bridge controller provides PX4-compatible telemetry on UDP :14550"
  ]
  title "Drone Detection World"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.01
  }
}
DEF MAIN_VIEW Viewpoint {
  position 0 -5 1.5
  near 0.2
  follow "Mavic2Pro"
  followSmoothness 0.15
}
TexturedBackground {
  luminosity 3
}
TexturedBackgroundLight {
}
Floor {
  size 400 400
  tileSize 6 6
  appearance SandyGround {
  }
}
