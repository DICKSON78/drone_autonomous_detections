  translation 44 -7 0.3
  rotation 0 0 1 0.5
  name "zb_box1"
}
CardboardBox {
  translation 52 -3 0.3
  rotation 0 0 1 -0.8
  name "zb_box2"
}
CardboardBox {
  translation 60 -5 0.3
  rotation 0 0 1 0.3
  name "zb_box3"
}

# Tesla parked on the road in Zone B
TeslaModel3Simple {
  translation 65 -3.5 0.31
  rotation 0 0 1 -1.5708
  name "zb_tesla"
}

# More cones on the curve entering Zone B
