# ===== ZONE B — Road Obstacle Course =====
# Traffic cones blocking the road — drone must detect & avoid
TrafficCone {
  translation 38 -5 0
  name "zb_cone1"
}
TrafficCone {
  translation 42 -6 0
  name "zb_cone2"
}
TrafficCone {
  translation 46 -4 0
  name "zb_cone3"
}
TrafficCone {
  translation 50 -6 0
  name "zb_cone4"
}
TrafficCone {
  translation 55 -4 0
  name "zb_cone5"
}

# Cardboard boxes on/near the road
