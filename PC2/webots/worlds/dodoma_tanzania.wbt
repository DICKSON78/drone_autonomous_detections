#VRML_SIM R2025a utf8
# UDOM CIVE Campus — texture-mapped buildings

EXTERNPROTO "../protos/Mavic2Pro.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo { title "UDOM CIVE Campus" basicTimeStep 16 defaultDamping Damping { linear 0.01 angular 0.01 } }
DEF MAIN_VIEW Viewpoint { orientation -0.2 0.98 0 1.59 position 2.5 0.5 0 near 0.1 follow "Mavic2Pro" followSmoothness 0.15 }
TexturedBackground { luminosity 4 }
TexturedBackgroundLight {}

# Ground
Solid {
  translation 0 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture { url ["../textures/ground_satellite.png"] }
        baseColor 0.72 0.64 0.44
        roughness 0.9 metalness 0
        textureTransform TextureTransform { scale 1 1 }
      }
      geometry Plane { size 600 600 }
    }
  ]
  boundingObject Box { size 600 600 0.2 }
  physics Physics { }
}

# ===== BUILDINGS =====

#New Labs
Solid { translation 0 -4 2.5
  name "new_labs"
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture { url ["../textures/bld_beige.png"] }
        baseColor 0.85 0.75 0.55
        roughness 0.8 metalness 0
      }
      geometry Box { size 22 14 5 }
    }
    Transform { translation 0 0 2.6
      children [ Shape {
        appearance PBRAppearance {
          baseColorMap ImageTexture { url ["../textures/roof_tile.png"] }
          baseColor 0.55 0.32 0.18
          roughness 0.9 metalness 0
        }
        geometry Box { size 22.4 14.4 0.15 }
      } ] }
  ]
  boundingObject Box { size 22 14 5 }
}
