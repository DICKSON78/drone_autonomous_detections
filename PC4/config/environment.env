# Environment variables for PC4 runtime configuration
# PC4 hosts Feedback Service (TTS)

# IP addresses of team PCs (change to actual LAN IPs)
PC1_IP=${PC1_IP:-192.168.1.101}
PC2_IP=${PC2_IP:-192.168.1.102}
PC3_IP=${PC3_IP:-192.168.1.103}
PC4_IP=localhost

# Kafka connection (Docker host → localhost:29092 for PLAINTEXT_HOST)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
